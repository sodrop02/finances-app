# ---- Copy this file to api/.env and fill in the values ----

# Plaid (get these from https://dashboard.plaid.com -> Developers -> Keys)
# NOTE: client_id is the same for every environment, but each environment
# (Sandbox / Production) has its OWN secret. PLAID_SECRET must match PLAID_ENV.
PLAID_CLIENT_ID=
PLAID_SECRET=
# one of: sandbox | development | production
PLAID_ENV=sandbox

# Optional: public URL Plaid should POST webhooks to (use ngrok/cloudflared in dev)
# PLAID_WEBHOOK_URL=https://your-tunnel.example.com/api/plaid/webhook

# App auth — single user. Pick any password; you type it on the login screen.
APP_PASSWORD=changeme

# Secrets — generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COOKIE_SECRET=
ENCRYPTION_KEY=

# Server
PORT=4000
DATABASE_URL="file:./prisma/dev.db"

# Where the web app is served from (for CORS)
WEB_ORIGIN=http://localhost:5173
